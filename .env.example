# Onti Erlani Hub — environment. Copy to `.env` (never commit .env) and fill in.
# Everything editable at runtime (persona, budget, safety texts...) is on the
# Settings page instead and stored in the database.

# ---------------------------------------------------------------- core
APP_ENV=dev
LOG_LEVEL=INFO
TIMEZONE=Asia/Jakarta
# Public URL of the API. Use your cloudflared tunnel URL when testing webhooks;
# the Settings page shows webhook URLs built from it.
API_BASE_URL=http://localhost:8000
# Admin UI origin (CORS + CSRF origin check). Extra origins: CORS_ORIGINS=a,b
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=
# Browser -> API URL baked into the web image at build time (docker compose).
PUBLIC_API_URL=http://localhost:8000

# Postgres password used by docker compose (db service + DATABASE_URL).
POSTGRES_PASSWORD=change-me-db-password
# Only for running the API outside Docker; compose overrides these two.
DATABASE_URL=postgresql+asyncpg://onti:change-me-db-password@localhost:5432/onti
# Empty = no Redis (jobs run in-process; single-process dev and tests only).
REDIS_URL=redis://localhost:6379/0

# Signs session cookies. Long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# true when the admin UI is served over https.
COOKIE_SECURE=false
SESSION_HOURS=12

# First admin, created on API start if the email doesn't exist yet (password is
# never overwritten afterwards; change it in the UI).
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ---------------------------------------------------------------- LLM
# groq | anthropic | fake (fake = offline canned answers, no API calls)
LLM_PROVIDER=groq
LLM_API_KEY=
# Empty = provider defaults:
#   groq      -> llama-3.3-70b-versatile / llama-3.1-8b-instant
#   anthropic -> claude-sonnet-5-5 / claude-haiku-4-5-20251001
# (the Settings page can override these too)
# Anthropic keys not scoped to a workspace (error "must include the
# anthropic-workspace-id header") need the workspace ID from
# console.anthropic.com -> Settings -> Workspaces (wrkspc_...). Or create a
# workspace-scoped API key and leave this empty.
ANTHROPIC_WORKSPACE_ID=
LLM_MODEL_ANSWER=
LLM_MODEL_CLASSIFIER=
# For cost estimates in IDR.
USD_TO_IDR=16500
LLM_TIMEOUT_SECONDS=45

# ---------------------------------------------------------------- knowledge base (rag/)
# Embedding model + prefixes. Changing any of these needs a re-index:
#   docker compose exec api python scripts/reindex_kb.py && docker compose restart worker
# Defaults (leave commented unless switching embedders; keep the quotes):
# EMBED_MODEL=intfloat/multilingual-e5-small
# QUERY_INSTRUCTION="query: "
# PASSAGE_PREFIX="passage: "
# Passages retrieved per answer (fixed k keeps prompt cost bounded).
TOP_K=4

# ---------------------------------------------------------------- WhatsApp Cloud API
# Meta App Dashboard -> WhatsApp -> API Setup: temporary access token (24 h),
# Phone number ID and WhatsApp Business Account ID.
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
# App Dashboard -> App settings -> Basic -> App secret (verifies X-Hub-Signature-256).
WA_APP_SECRET=
# Any random string; paste the same value into Meta's webhook "Verify token".
WA_VERIFY_TOKEN=
WA_GRAPH_VERSION=v25.0
GRAPH_BASE_URL=https://graph.facebook.com

# ---------------------------------------------------------------- Messenger / Instagram (off)
ENABLE_MESSENGER=false
ENABLE_INSTAGRAM=false
# Facebook Page connected to the app (Instagram professional account linked to it).
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_ACCOUNT_ID=
# Empty = reuse WA_APP_SECRET / WA_VERIFY_TOKEN (same Meta app).
META_APP_SECRET=
META_VERIFY_TOKEN=

# ---------------------------------------------------------------- email alerts (optional)
# Leave SMTP_HOST empty to disable. Alerts go to ALERT_EMAILS, or to all active
# admins and agents when that is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
ALERT_EMAILS=

# ---------------------------------------------------------------- broadcasts
BROADCAST_RATE_PER_SECOND=5
BROADCAST_MAX_ATTEMPTS=3

# ---------------------------------------------------------------- demo / e2e
# Password for the demo staff accounts created by scripts/seed_demo.py.
DEMO_STAFF_PASSWORD=
WORKER_MAX_JOBS=10
